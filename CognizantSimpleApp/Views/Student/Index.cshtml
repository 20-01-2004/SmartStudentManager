
@model IEnumerable<CognizantSimpleApp.Models.Student>

<h2>Student Management System</h2>

<a href="/Student/Create">Add Student</a>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Department</td>
            <td>
                <a href="/Student/Delete/@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>
